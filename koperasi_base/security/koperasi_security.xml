<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_koperasi" model="ir.module.category">
        <field name="name">Koperasi</field>
        <field name="sequence">5</field>
    </record>

    <record id="res_groups_privilege_koperasi" model="res.groups.privilege">
        <field name="name">Koperasi</field>
        <field name="category_id" ref="module_category_koperasi"/>
        <field name="sequence">5</field>
    </record>

    <!-- Petugas: input pengajuan, terima angsuran -->
    <record id="group_koperasi_petugas" model="res.groups">
        <field name="name">Petugas</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_koperasi"/>
        <field name="comment">Input pengajuan pembiayaan dan terima angsuran.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Pengurus: setujui akad, pelunasan dipercepat, batal -->
    <record id="group_koperasi_pengurus" model="res.groups">
        <field name="name">Pengurus</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_koperasi"/>
        <field name="comment">Menyetujui dan membatalkan akad, pelunasan dipercepat.</field>
        <field name="implied_ids" eval="[(4, ref('group_koperasi_petugas'))]"/>
    </record>

    <!-- Akuntan: lihat semua, laporan, konfigurasi akun -->
    <record id="group_koperasi_akuntan" model="res.groups">
        <field name="name">Akuntan</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_koperasi"/>
        <field name="comment">Melihat semua data, laporan, dan konfigurasi akun.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- Untuk sekarang hanya akun admin, dengan ketiga grup (keputusan pemilik 18 Okt 2026) -->
    <record id="group_koperasi_pengurus" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_koperasi_akuntan" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
