<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TEMPLATE FORMULIR PENDAFTARAN ANGGOTA -->
    <template id="form_daftar" name="Pendaftaran Anggota Koperasi">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure ksbk-body py-5">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="text-center mb-4">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold mb-2">
                                    Formulir Registrasi
                                </span>
                                <h2 class="fw-bold">Pendaftaran Anggota <t t-out="res_company.name"/></h2>
                                <p class="text-muted">
                                    Mari bersama-sama menguatkan ekonomi syariah umat yang berkeadilan, amanah, dan tanpa riba.
                                </p>
                            </div>

                            <!-- Alert Errors -->
                            <t t-if="errors">
                                <div class="alert alert-danger shadow-sm rounded-3 mb-4" role="alert">
                                    <h6 class="fw-bold mb-2"><i class="fa fa-exclamation-triangle me-2"></i> Mohon lengkapi data berikut:</h6>
                                    <ul class="mb-0 ps-3">
                                        <t t-foreach="errors" t-as="err">
                                            <li><t t-out="err"/></li>
                                        </t>
                                    </ul>
                                </div>
                            </t>

                            <!-- Form Container -->
                            <div class="ksbk-form-container">
                                <form action="/daftar" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3">
                                        <i class="fa fa-user me-2"></i> Data Identitas Diri
                                    </h5>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Nama Lengkap (sesuai KTP) <span class="text-danger">*</span></label>
                                        <input type="text" name="name" class="form-control ksbk-form-control"
                                               placeholder="Contoh: Muhammad Fulan"
                                               t-att-value="post.get('name', '')" required="required"/>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">NIK / Nomor KTP (16 Digit) <span class="text-danger">*</span></label>
                                            <input type="text" name="nik" class="form-control ksbk-form-control"
                                                   placeholder="3201xxxxxxxxxxxx" maxlength="16"
                                                   t-att-value="post.get('nik', '')" required="required"/>
                                            <small class="text-muted" style="font-size: 0.75rem;">Hanya angka, 16 digit sesuai e-KTP.</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Nomor WhatsApp Aktif <span class="text-danger">*</span></label>
                                            <input type="tel" name="phone" class="form-control ksbk-form-control"
                                                   placeholder="081234567890"
                                                   t-att-value="post.get('phone', '')" required="required"/>
                                            <small class="text-muted" style="font-size: 0.75rem;">Untuk konfirmasi dan info keanggotaan.</small>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Alamat Email</label>
                                            <input type="email" name="email" class="form-control ksbk-form-control"
                                                   placeholder="nama@email.com"
                                                   t-att-value="post.get('email', '')"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Pekerjaan / Instansi / Usaha</label>
                                            <input type="text" name="pekerjaan" class="form-control ksbk-form-control"
                                                   placeholder="Contoh: Wiraswasta / Karyawan"
                                                   t-att-value="post.get('pekerjaan', '')"/>
                                        </div>
                                    </div>

                                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3 mt-4">
                                        <i class="fa fa-map-marker me-2"></i> Domisili &amp; Dokumen
                                    </h5>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Alamat Lengkap</label>
                                        <textarea name="street" class="form-control ksbk-form-control" rows="2"
                                                  placeholder="Jalan, RT/RW, Kelurahan, Kecamatan"><t t-out="post.get('street', '')"/></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Kota / Kabupaten</label>
                                        <input type="text" name="city" class="form-control ksbk-form-control"
                                               placeholder="Contoh: Jakarta Selatan"
                                               t-att-value="post.get('city', '')"/>
                                    </div>

                                    <div class="mb-4">
                                        <label class="ksbk-form-label">Foto / Scan e-KTP (Opsional)</label>
                                        <input type="file" name="ktp_file" class="form-control ksbk-form-control" accept="image/*,.pdf"/>
                                        <small class="text-muted" style="font-size: 0.75rem;">Format JPG, PNG, atau PDF maksimal 5MB.</small>
                                    </div>

                                    <!-- Pernyataan Syariat -->
                                    <div class="form-check p-3 bg-light rounded-3 mb-4">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="checkAgree" required="required"/>
                                        <label class="form-check-label small text-muted" for="checkAgree">
                                            Saya menyatakan bahwa data yang saya berikan adalah benar, dan saya bersedia mematuhi Anggaran Dasar / Anggaran Rumah Tangga (AD/ART) serta prinsip syariah <t t-out="res_company.name"/>.
                                        </label>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-ksbk-gold py-3 fs-6">
                                            <i class="fa fa-check-circle me-1"></i> Kirim Pendaftaran Anggota
                                        </button>
                                        <a href="/" class="btn btn-link text-muted text-decoration-none">
                                            <i class="fa fa-arrow-left me-1"></i> Batal &amp; Kembali ke Beranda
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- TEMPLATE SUKSES PENDAFTARAN ANGGOTA -->
    <template id="daftar_sukses" name="Pendaftaran Anggota Berhasil">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure ksbk-body py-5">
                <div class="container py-4">
                    <div class="row justify-content-center">
                        <div class="col-lg-7">
                            <div class="ksbk-success-card">
                                <div class="ksbk-success-icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <h3 class="fw-bold mb-2">Alhamdulillah, Pendaftaran Berhasil!</h3>
                                <p class="text-muted mb-4">
                                    Terima kasih, data pendaftaran Anda telah tersimpan di sistem <t t-out="res_company.name"/>.
                                </p>

                                <div class="card bg-light border-0 text-start p-3 rounded-3 mb-4">
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">Nama Pemohon:</div>
                                        <div class="col-8 fw-bold"><t t-out="partner_name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">NIK KTP:</div>
                                        <div class="col-8"><t t-out="partner_nik"/></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4 text-muted small">No. WhatsApp:</div>
                                        <div class="col-8"><t t-out="partner_phone"/></div>
                                    </div>
                                </div>

                                <div class="alert alert-info border-0 rounded-3 text-start small mb-4">
                                    <i class="fa fa-info-circle me-1"></i>
                                    <strong>Langkah Selanjutnya:</strong> Silakan klik tombol WhatsApp di bawah untuk konfirmasi ke admin pengurus koperasi terkait verifikasi data dan informasi simpanan pokok &amp; wajib.
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    <a t-att-href="wa_url" target="_blank" class="btn btn-success py-3 fw-bold rounded-3">
                                        <i class="fa fa-whatsapp fa-lg me-2"></i> Konfirmasi ke WhatsApp Admin
                                    </a>
                                    <a href="/" class="btn btn-outline-secondary py-2 rounded-3">
                                        Kembali ke Halaman Utama
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
