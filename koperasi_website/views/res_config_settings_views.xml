<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_website" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.koperasi.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="koperasi_murabahah.res_config_settings_view_form_murabahah"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='koperasi_murabahah']" position="inside">
                <block title="Integrasi Website Publik &amp; WhatsApp" name="koperasi_website_settings">
                    <setting string="WhatsApp CS"
                             help="Nomor WhatsApp admin koperasi untuk menerima notifikasi pendaftaran dan pengajuan baru.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="koperasi_wa_number" class="col-lg-5 o_light_label"/>
                                <field name="koperasi_wa_number"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Simulasi Angsuran"
                             help="Margin persentase default yang ditampilkan pada kalkulator website publik.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="koperasi_simulasi_margin_pct" class="col-lg-5 o_light_label"/>
                                <field name="koperasi_simulasi_margin_pct"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
