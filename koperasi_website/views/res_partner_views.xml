<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tambahan kolom di form partner -->
    <record id="view_partner_form_koperasi_website" model="ir.ui.view">
        <field name="name">res.partner.form.koperasi.website</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_approve_as_member" string="Jadikan Anggota Resmi"
                            type="object" class="btn-primary"
                            invisible="koperasi_status == 'anggota' or not koperasi_is_applicant"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='koperasi_membership']//group" position="inside">
                <group string="Data Tambahan Web">
                    <field name="koperasi_is_applicant" readonly="1"/>
                    <field name="koperasi_application_date" readonly="1" invisible="not koperasi_is_applicant"/>
                    <field name="koperasi_ktp_image" widget="image" options="{'size': [200, 150]}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action & Menu Pendaftar Online -->
    <record id="action_koperasi_pendaftar_online" model="ir.actions.act_window">
        <field name="name">Pendaftar Online</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('koperasi_is_applicant', '=', True)]</field>
        <field name="context">{'default_koperasi_is_applicant': True, 'default_koperasi_status': 'non_anggota'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada pendaftaran online dari website.
            </p>
            <p>
                Setiap calon anggota yang mengisi formulir di website /daftar akan muncul di sini untuk diverifikasi.
            </p>
        </field>
    </record>

    <menuitem id="menu_koperasi_pendaftar_online"
              name="Pendaftar Online"
              parent="koperasi_base.menu_koperasi_root"
              action="action_koperasi_pendaftar_online"
              sequence="15"/>
</odoo>
