<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TEMPLATE FORMULIR PENGAJUAN PEMBIAYAAN -->
    <template id="form_pengajuan" name="Pengajuan Pembiayaan Murabahah">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure ksbk-body py-5">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-lg-9">
                            <div class="text-center mb-4">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold mb-2">
                                    Formulir Online
                                </span>
                                <h2 class="fw-bold">Pengajuan Pembiayaan Murabahah</h2>
                                <p class="text-muted">
                                    Dapatkan fasilitas pembiayaan pengadaan barang dan kebutuhan usaha secara halal, berkah, dan transparan.
                                </p>
                            </div>

                            <!-- Alert Errors -->
                            <t t-if="errors">
                                <div class="alert alert-danger shadow-sm rounded-3 mb-4" role="alert">
                                    <h6 class="fw-bold mb-2"><i class="fa fa-exclamation-triangle me-2"></i> Periksa kembali isian formulir:</h6>
                                    <ul class="mb-0 ps-3">
                                        <t t-foreach="errors" t-as="err">
                                            <li><t t-out="err"/></li>
                                        </t>
                                    </ul>
                                </div>
                            </t>

                            <div class="ksbk-form-container">
                                <form action="/pengajuan" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div style="position:absolute; left:-10000px;" aria-hidden="true">
                                        <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                                    </div>

                                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3">
                                        <i class="fa fa-user me-2"></i> Data Pemohon
                                    </h5>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Nama Lengkap Pemohon <span class="text-danger">*</span></label>
                                            <input type="text" name="name" class="form-control ksbk-form-control"
                                                   placeholder="Nama sesuai KTP"
                                                   t-att-value="post.get('name', '')" required="required"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Nomor WhatsApp Aktif <span class="text-danger">*</span></label>
                                            <input type="tel" name="phone" class="form-control ksbk-form-control"
                                                   placeholder="081234567890"
                                                   t-att-value="post.get('phone', '')" required="required"/>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">NIK KTP (16 digit)</label>
                                            <input type="text" name="nik" class="form-control ksbk-form-control"
                                                   placeholder="3201xxxxxxxxxxxx" maxlength="16"
                                                   t-att-value="post.get('nik', '')"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Alamat Email</label>
                                            <input type="email" name="email" class="form-control ksbk-form-control"
                                                   placeholder="nama@email.com"
                                                   t-att-value="post.get('email', '')"/>
                                        </div>
                                    </div>

                                    <h5 class="fw-bold text-success border-bottom pb-2 mb-3">
                                        <i class="fa fa-shopping-bag me-2"></i> Rincian Kebutuhan &amp; Pembiayaan
                                    </h5>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Pekerjaan / Sumber Penghasilan</label>
                                            <input type="text" name="income_source" class="form-control ksbk-form-control"
                                                   placeholder="Contoh: Karyawan PT X / Pedagang"
                                                   t-att-value="post.get('income_source', '')"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Penghasilan per Bulan (Rp)</label>
                                            <input type="text" name="monthly_income" class="form-control ksbk-form-control text-end"
                                                   placeholder="0" t-att-value="post.get('monthly_income', '')"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Kategori Barang <span class="text-danger">*</span></label>
                                        <select name="kategori_id" class="form-select ksbk-form-control" required="required">
                                            <option value="">-- Pilih kategori --</option>
                                            <t t-foreach="kategori_list" t-as="kat">
                                                <option t-att-value="kat.id"
                                                        t-att-selected="'selected' if str(kat.id) == post.get('kategori_id') else None">
                                                    <t t-out="kat.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Barang / Kebutuhan yang Diajukan <span class="text-danger">*</span></label>
                                        <input type="text" name="product_desc" class="form-control ksbk-form-control"
                                               placeholder="Contoh: Mesin Jahit Industri Juki / Laptop Lenovo ThinkPad / Motor Honda Vario"
                                               t-att-value="post.get('product_desc', '')" required="required"/>
                                        <small class="text-muted" style="font-size: 0.75rem;">Sebutkan merek, model, atau spesifikasi barang yang ingin dibeli koperasi.</small>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4">
                                            <label class="ksbk-form-label">Estimasi Harga Barang (Rp) <span class="text-danger">*</span></label>
                                            <input type="text" name="cost_price" class="form-control ksbk-form-control text-end fw-bold"
                                                   t-att-value="default_cost" required="required"/>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="ksbk-form-label">Rencana Uang Muka / DP (Rp)</label>
                                            <input type="text" name="down_payment" class="form-control ksbk-form-control text-end"
                                                   t-att-value="default_dp" placeholder="0"/>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="ksbk-form-label">Jangka Waktu (Tenor) <span class="text-danger">*</span></label>
                                            <select name="tenor" class="form-select ksbk-form-control">
                                                <option value="3" t-att-selected="'selected' if default_tenor == '3' else None">3 Bulan</option>
                                                <option value="6" t-att-selected="'selected' if default_tenor == '6' else None">6 Bulan</option>
                                                <option value="12" t-att-selected="'selected' if default_tenor == '12' else None">12 Bulan (1 Tahun)</option>
                                                <option value="18" t-att-selected="'selected' if default_tenor == '18' else None">18 Bulan</option>
                                                <option value="24" t-att-selected="'selected' if default_tenor == '24' else None">24 Bulan (2 Tahun)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="ksbk-form-label">Dealer / Toko Penjual</label>
                                        <input type="text" name="supplier_name" class="form-control ksbk-form-control"
                                               placeholder="Contoh: Dealer Honda X, Padang"
                                               t-att-value="post.get('supplier_name', '')"/>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Foto KTP (opsional)</label>
                                            <input type="file" name="ktp_file" class="form-control ksbk-form-control"
                                                   accept="image/jpeg,image/png,application/pdf"/>
                                            <small class="text-muted" style="font-size: 0.75rem;">JPG/PNG/PDF, maks. 5 MB. Lebih aman daripada mengirim lewat chat.</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ksbk-form-label">Penawaran Harga / Brosur (opsional)</label>
                                            <input type="file" name="penawaran_file" class="form-control ksbk-form-control"
                                                   accept="image/jpeg,image/png,application/pdf"/>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="ksbk-form-label">Catatan Tambahan / Link Toko Pemasok</label>
                                        <textarea name="note" class="form-control ksbk-form-control" rows="2"
                                                  placeholder="Tuliskan jika ada rincian supplier, link pembelian, atau keterangan penting lainnya."><t t-out="post.get('note', '')"/></textarea>
                                    </div>

                                    <!-- Informasi Skema Murabahah -->
                                    <div class="p-3 bg-light rounded-3 border mb-4">
                                        <h6 class="fw-bold mb-1"><i class="fa fa-info-circle text-success me-1"></i> Transparansi Akad Syariah</h6>
                                        <p class="small text-muted mb-0">
                                            Setelah formulir ini dikirim, petugas <t t-out="res_company.name"/> akan menghubungi Anda untuk verifikasi identitas (dokumen asli), dokumen penghasilan, dan survei. Jika disetujui, Koperasi akan membeli barang tersebut dari pemasok, kemudian menjualnya kepada Anda dengan harga jual yang jelas (Harga Beli + Margin Syariah) dengan angsuran tetap.
                                        </p>
                                    </div>

                                    <div class="form-check mb-4">
                                        <input class="form-check-input" type="checkbox" name="consent" value="1" id="ksbk-consent"
                                               required="required" t-att-checked="'checked' if post.get('consent') else None"/>
                                        <label class="form-check-label small" for="ksbk-consent">
                                            Saya setuju data pribadi dan dokumen yang saya kirim dipakai <t t-out="res_company.name"/> untuk
                                            memproses pengajuan ini (verifikasi identitas dan kelayakan), dan tidak diberikan
                                            kepada pihak lain kecuali diwajibkan peraturan.
                                        </label>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-ksbk-green py-3 fs-6">
                                            <i class="fa fa-paper-plane me-1"></i> Kirim Pengajuan Pembiayaan
                                        </button>
                                        <a href="/" class="btn btn-link text-muted text-decoration-none">
                                            <i class="fa fa-arrow-left me-1"></i> Kembali ke Beranda
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- TEMPLATE SUKSES PENGAJUAN PEMBIAYAAN -->
    <template id="pengajuan_sukses" name="Pengajuan Pembiayaan Berhasil">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure ksbk-body py-5">
                <div class="container py-4">
                    <div class="row justify-content-center">
                        <div class="col-lg-7">
                            <div class="ksbk-success-card">
                                <div class="ksbk-success-icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <h3 class="fw-bold mb-2">Pengajuan Berhasil Dikirim!</h3>
                                <p class="text-muted mb-4">
                                    Permohonan pembiayaan Anda telah kami terima dan masuk ke dalam daftar verifikasi komite koperasi.
                                </p>

                                <div class="card bg-light border-0 text-start p-3 rounded-3 mb-4">
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">No. Pengajuan:</div>
                                        <div class="col-8 fw-bold text-success"><t t-out="akad_name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">Nama Pemohon:</div>
                                        <div class="col-8 fw-bold"><t t-out="applicant_name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">Barang / Kebutuhan:</div>
                                        <div class="col-8"><t t-out="product_desc"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-4 text-muted small">Perkiraan Harga:</div>
                                        <div class="col-8 fw-bold">Rp <t t-out="cost_price_formatted"/></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4 text-muted small">Tenor:</div>
                                        <div class="col-8"><t t-out="tenor"/> Bulan</div>
                                    </div>
                                </div>

                                <div class="alert alert-info border-0 rounded-3 text-start small mb-4">
                                    <i class="fa fa-whatsapp text-success me-1"></i>
                                    <strong>Percepat Proses Verifikasi:</strong> Hubungi admin komite kami via WhatsApp dengan mengklik tombol di bawah ini agar berkas Anda segera ditindaklanjuti.
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    <a t-att-href="wa_url" target="_blank" class="btn btn-success py-3 fw-bold rounded-3">
                                        <i class="fa fa-whatsapp fa-lg me-2"></i> Konfirmasi ke WhatsApp Admin
                                    </a>
                                    <a href="/" class="btn btn-outline-secondary py-2 rounded-3">
                                        Kembali ke Halaman Utama
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- TEMPLATE HALAMAN MANDIRI SIMULASI -->
    <template id="simulasi_page" name="Kalkulator Simulasi Angsuran Syariah">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure ksbk-body py-5">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-lg-7">
                            <div class="text-center mb-4">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold mb-2">
                                    Transparansi Angsuran
                                </span>
                                <h2 class="fw-bold">Kalkulator Simulasi Murabahah</h2>
                                <p class="text-muted">
                                    Hitung estimasi angsuran pembiayaan barang Anda secara mandiri tanpa biaya tersembunyi.
                                </p>
                            </div>

                            <!-- Kalkulator Widget -->
                            <div class="ksbk-calc-card shadow" id="ksbk-calc-widget" t-att-data-margin-pct="margin_pct">
                                <div class="ksbk-slider-container">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold mb-0">Jumlah Pembiayaan (Plafon)</label>
                                        <input type="text" id="calc-plafon-input" class="form-control text-end fw-bold text-success border-success" style="max-width: 170px;" value="Rp 10.000.000"/>
                                    </div>
                                    <input type="range" class="form-range" id="calc-plafon-slider" min="1000000" max="100000000" step="1000000" value="10000000"/>
                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                                        <span>Rp 1.000.000</span>
                                        <span>Rp 50.000.000</span>
                                        <span>Rp 100.000.000</span>
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Jangka Waktu (Tenor)</label>
                                        <select id="calc-tenor-select" class="form-select">
                                            <option value="3">3 Bulan</option>
                                            <option value="6">6 Bulan</option>
                                            <option value="12" selected="selected">12 Bulan (1 Tahun)</option>
                                            <option value="18">18 Bulan</option>
                                            <option value="24">24 Bulan (2 Tahun)</option>
                                            <option value="36">36 Bulan (3 Tahun)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Rencana Uang Muka (DP)</label>
                                        <input type="text" id="calc-dp-input" class="form-control text-end" value="Rp 0" placeholder="Rp 0"/>
                                    </div>
                                </div>

                                <div class="ksbk-calc-result text-center">
                                    <span class="text-muted small fw-semibold text-uppercase">Estimasi Angsuran / Bulan</span>
                                    <div class="ksbk-result-val mt-1" id="calc-result-angsuran">Rp 1.000.000</div>
                                    <div class="row pt-3 mt-3 border-top border-success border-opacity-25 small">
                                        <div class="col-4 text-start">
                                            <span class="text-muted">Porsi Pokok:</span><br/>
                                            <strong id="calc-result-pokok">Rp 833.333</strong>
                                        </div>
                                        <div class="col-4 text-center">
                                            <span class="text-muted">Porsi Margin:</span><br/>
                                            <strong id="calc-result-margin">Rp 166.667</strong>
                                        </div>
                                        <div class="col-4 text-end">
                                            <span class="text-muted">Total Bayar:</span><br/>
                                            <strong id="calc-result-total">Rp 12.000.000</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 text-center">
                                    <a href="/pengajuan" id="calc-btn-ajukan" class="btn btn-ksbk-gold w-100 py-3 fw-bold fs-6">
                                        Ajukan Pembiayaan dengan Simulasi Ini <i class="fa fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
