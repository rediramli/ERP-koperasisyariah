<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.form</field>
        <field name="model">koperasi.murabahah.payment</field>
        <field name="arch" type="xml">
            <form string="Pembayaran Murabahah" create="false" delete="false">
                <header>
                    <button name="action_cancel" type="object" string="Batalkan Pembayaran"
                            invisible="state != 'posted' or payment_type == 'saldo_awal'"
                            groups="koperasi_base.group_koperasi_pengurus"
                            confirm="Jurnal pembayaran ini akan dibalik. Lanjutkan?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="akad_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="payment_type"/>
                            <field name="journal_id" invisible="payment_type == 'saldo_awal'"/>
                            <field name="memo"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="amount_principal"/>
                            <field name="amount_margin"/>
                            <field name="amount_discount" invisible="not amount_discount"/>
                            <field name="discount_type" invisible="not discount_type"/>
                            <field name="discount_note" invisible="not discount_note"/>
                            <field name="amount_tazir" invisible="not amount_tazir"/>
                            <field name="amount_cash" invisible="payment_type == 'saldo_awal'"/>
                            <field name="move_id" groups="koperasi_base.group_koperasi_akuntan,koperasi_base.group_koperasi_pengurus"/>
                            <field name="margin_move_id" groups="koperasi_base.group_koperasi_akuntan,koperasi_base.group_koperasi_pengurus"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="installment_no"/>
                            <field name="angsuran_id"/>
                            <field name="amount_principal" sum="Total"/>
                            <field name="amount_margin" sum="Total"/>
                            <field name="amount_discount" sum="Total" optional="show"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_list" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.list</field>
        <field name="model">koperasi.murabahah.payment</field>
        <field name="arch" type="xml">
            <list string="Pembayaran Murabahah" create="false" delete="false" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="akad_id"/>
                <field name="partner_id"/>
                <field name="payment_type"/>
                <field name="journal_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="amount_margin" sum="Total"/>
                <field name="amount_tazir" sum="Total" optional="show"/>
                <field name="amount_cash" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_payment_search" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.search</field>
        <field name="model">koperasi.murabahah.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="akad_id"/>
                <field name="partner_id"/>
                <filter string="Diposting" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Tanggal" name="filter_date" date="date"/>
                <group>
                    <filter string="Bulan" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Anggota / Nasabah" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Pembayaran Angsuran</field>
        <field name="res_model">koperasi.murabahah.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_posted': 1, 'create': False}</field>
    </record>

    <!-- Rekap pendapatan margin per periode -->
    <record id="view_payment_line_pivot" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.line.pivot</field>
        <field name="model">koperasi.murabahah.payment.line</field>
        <field name="arch" type="xml">
            <pivot string="Rekap Pendapatan Margin">
                <field name="date" interval="month" type="row"/>
                <field name="amount_margin" type="measure"/>
                <field name="amount_principal" type="measure"/>
                <field name="amount_discount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_payment_line_list" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.line.list</field>
        <field name="model">koperasi.murabahah.payment.line</field>
        <field name="arch" type="xml">
            <list string="Rekap Pendapatan Margin" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="payment_id"/>
                <field name="akad_id"/>
                <field name="partner_id"/>
                <field name="installment_no"/>
                <field name="amount_principal" sum="Total"/>
                <field name="amount_margin" sum="Total"/>
                <field name="amount_discount" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_payment_line_search" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.line.search</field>
        <field name="model">koperasi.murabahah.payment.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="akad_id"/>
                <field name="partner_id"/>
                <filter string="Tanggal" name="filter_date" date="date"/>
                <group>
                    <filter string="Bulan" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Akad" name="group_akad" context="{'group_by': 'akad_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_margin_recap" model="ir.actions.act_window">
        <field name="name">Rekap Pendapatan Margin</field>
        <field name="res_model">koperasi.murabahah.payment.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="view_payment_line_search"/>
        <!-- Saldo awal (migrasi) margins were recognised before the system and are not income of the period -->
        <field name="domain">[('state', '=', 'posted'), ('payment_type', '!=', 'saldo_awal')]</field>
    </record>
</odoo>
