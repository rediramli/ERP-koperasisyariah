<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pengajuan_list" model="ir.ui.view">
        <field name="name">koperasi.murabahah.pengajuan.list</field>
        <field name="model">koperasi.murabahah.pengajuan</field>
        <field name="arch" type="xml">
            <list string="Pengajuan Pembiayaan" decoration-muted="state in ('ditolak', 'batal')"
                  decoration-success="state == 'disetujui'">
                <field name="name"/>
                <field name="date_request"/>
                <field name="partner_id"/>
                <field name="applicant_name" optional="hide"/>
                <field name="kategori_id"/>
                <field name="product_desc"/>
                <field name="estimated_price" sum="Total"/>
                <field name="tenor"/>
                <field name="channel" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="doc_progress" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('baru', 'kyc', 'survei')"
                       decoration-warning="state == 'analisis'"
                       decoration-success="state == 'disetujui'"
                       decoration-danger="state == 'ditolak'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pengajuan_kanban" model="ir.ui.view">
        <field name="name">koperasi.murabahah.pengajuan.kanban</field>
        <field name="model">koperasi.murabahah.pengajuan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false" quick_create="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="date_request" class="text-muted"/>
                        </div>
                        <field name="partner_id" class="fw-bold"/>
                        <field name="applicant_name" invisible="partner_id"/>
                        <field name="product_desc"/>
                        <div class="d-flex justify-content-between">
                            <field name="estimated_price" widget="monetary"/>
                            <span><field name="tenor"/> bln</span>
                        </div>
                        <footer>
                            <span class="text-muted">Dokumen <field name="doc_progress"/></span>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pengajuan_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.pengajuan.form</field>
        <field name="model">koperasi.murabahah.pengajuan</field>
        <field name="arch" type="xml">
            <form string="Pengajuan Pembiayaan">
                <header>
                    <button name="action_find_or_create_partner" type="object" string="Cari/Buat Kontak Pemohon"
                            class="btn-primary" invisible="partner_id or state != 'baru'"/>
                    <button name="action_start_kyc" type="object" string="Lolos Pra-skrining → KYC" class="btn-primary"
                            invisible="state != 'baru' or not partner_id"/>
                    <button name="action_complete_kyc" type="object" string="KYC Selesai → Survei" class="btn-primary"
                            invisible="state != 'kyc'"/>
                    <button name="action_complete_survey" type="object" string="Survei Selesai → Buat Akad (Analisis)"
                            class="btn-primary" invisible="state != 'survei'"/>
                    <button name="action_view_akad" type="object" string="Buka Akad" class="btn-primary"
                            invisible="not akad_id"/>
                    <button name="action_reject" type="object" string="Tolak" invisible="state not in ('baru', 'kyc', 'survei')"
                            confirm="Tolak pengajuan ini? Pastikan Alasan Ditolak sudah diisi dan disampaikan ke pemohon."/>
                    <button name="action_cancel" type="object" string="Dibatalkan Pemohon"
                            invisible="state not in ('baru', 'kyc', 'survei')"/>
                    <button name="action_reset" type="object" string="Kembalikan ke Baru"
                            invisible="state not in ('kyc', 'survei', 'ditolak', 'batal') or akad_id"
                            groups="koperasi_base.group_koperasi_pengurus"/>
                    <field name="state" widget="statusbar" statusbar_visible="baru,kyc,survei,analisis,disetujui"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_akad" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not akad_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Akad</span>
                                <span class="o_stat_value"><field name="akad_state"/></span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Ditolak" bg_color="text-bg-danger" invisible="state != 'ditolak'"/>
                    <widget name="web_ribbon" title="Batal" bg_color="text-bg-secondary" invisible="state != 'batal'"/>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not prescreen_issues or state not in ('baru', 'kyc', 'survei')">
                        <strong>Pra-skrining:</strong>
                        <field name="prescreen_issues" nolabel="1" class="d-block" style="white-space: pre-line"/>
                        <span invisible="state != 'baru'">Proses lanjut hanya dengan Dasar Pengecualian (tab Pemohon &amp; Permohonan).</span>
                    </div>
                    <div class="alert alert-info mb-2" role="alert" invisible="state != 'kyc' or not kyc_missing">
                        <strong>Kekurangan KYC:</strong>
                        <field name="kyc_missing" nolabel="1" class="d-block" style="white-space: pre-line"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pemohon">
                            <field name="partner_id" readonly="state not in ('baru', 'kyc')"
                                   context="{'default_koperasi_status': 'non_anggota'}"/>
                            <field name="partner_status" invisible="not partner_id"/>
                            <field name="partner_risk_level" invisible="not partner_id"/>
                            <field name="penjamin_required" invisible="1"/>
                            <field name="penjamin_id" readonly="state not in ('baru', 'kyc')"
                                   required="penjamin_required and state == 'kyc'"
                                   invisible="not penjamin_required and not penjamin_id"/>
                            <field name="penjamin_relation" readonly="state not in ('baru', 'kyc')"
                                   invisible="not penjamin_id"/>
                            <field name="channel" readonly="state != 'baru'"/>
                            <field name="date_request" readonly="state != 'baru'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Barang &amp; Permohonan">
                            <field name="kategori_id" readonly="state not in ('baru', 'kyc')" options="{'no_create': True}"/>
                            <field name="product_desc" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <field name="supplier_name" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <field name="supplier_id" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <field name="estimated_price" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <label for="down_payment"/>
                            <div class="o_row">
                                <field name="down_payment" readonly="state not in ('baru', 'kyc', 'survei')"/>
                                <span>(<field name="dp_pct" class="oe_inline"/> %)</span>
                            </div>
                            <field name="tenor" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <field name="margin_pct" readonly="state not in ('baru', 'kyc', 'survei')"/>
                            <field name="est_installment"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pemohon &amp; Permohonan" name="request">
                            <group>
                                <group string="Data dari Permohonan" invisible="channel != 'website' and not applicant_name">
                                    <field name="applicant_name"/>
                                    <field name="applicant_phone" widget="phone"/>
                                    <field name="applicant_email" widget="email"/>
                                    <field name="applicant_nik"/>
                                    <field name="applicant_nik_info" invisible="not applicant_nik_info" class="text-muted"/>
                                    <field name="applicant_existing_id" invisible="not applicant_existing_id"/>
                                </group>
                                <group string="Penghasilan (pengakuan pemohon)">
                                    <field name="income_source"/>
                                    <field name="monthly_income"/>
                                    <field name="other_obligations"/>
                                    <field name="dependents"/>
                                    <field name="financing_purpose"/>
                                    <field name="purpose_note"/>
                                </group>
                            </group>
                            <group>
                                <field name="note"/>
                                <field name="prescreen_note" invisible="not prescreen_issues and not prescreen_note"
                                       readonly="state != 'baru'"/>
                                <field name="reject_reason" invisible="state not in ('baru', 'kyc', 'survei', 'ditolak', 'batal')"
                                       readonly="state in ('ditolak', 'batal')"/>
                            </group>
                        </page>
                        <page string="Dokumen" name="documents">
                            <div class="text-muted mb-2">
                                Unggah file, cocokkan dengan dokumen asli, lalu centang <em>Terverifikasi</em>.
                                Dokumen yang tidak berlaku: centang <em>Tidak Berlaku</em> dan isi alasannya.
                                Wajib lengkap: <field name="doc_progress" class="oe_inline fw-bold"/>
                            </div>
                            <field name="dokumen_ids" readonly="state in ('ditolak', 'batal')">
                                <list editable="bottom" create="false" delete="false"
                                      decoration-success="is_complete" decoration-muted="not_applicable">
                                    <field name="phase"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="attachment" filename="attachment_name" widget="binary"/>
                                    <field name="attachment_name" column_invisible="1"/>
                                    <field name="original_check" column_invisible="1"/>
                                    <field name="original_seen" invisible="not original_check"/>
                                    <field name="verified"/>
                                    <field name="verified_by_id" optional="show"/>
                                    <field name="verified_date" optional="hide"/>
                                    <field name="not_applicable"/>
                                    <field name="note"/>
                                    <field name="is_complete" column_invisible="1"/>
                                </list>
                            </field>
                            <group invisible="not doc_request_text">
                                <field name="doc_request_text" widget="CopyClipboardButton"
                                       string="Pesan WA Permintaan Dokumen"/>
                            </group>
                        </page>
                        <page string="Verifikasi KYC" name="kyc" invisible="state == 'baru'">
                            <div class="text-muted mb-2">
                                Data identitas, pasangan, kontak darurat, cek DTTOT/PEP, dan tingkat risiko diisi di
                                kontak pemohon (tab <em>Identitas &amp; KYC</em>), supaya dipakai ulang di pengajuan berikutnya.
                            </div>
                            <group>
                                <group string="Konfirmasi">
                                    <field name="phone_verified" readonly="state != 'kyc'"/>
                                    <field name="emergency_verified" readonly="state != 'kyc'"/>
                                    <field name="address_verified" readonly="state != 'kyc'"/>
                                    <field name="employment_verified" readonly="state != 'kyc'"/>
                                </group>
                                <group string="Hasil">
                                    <field name="partner_marital"/>
                                    <field name="partner_age"/>
                                    <field name="kyc_user_id"/>
                                    <field name="kyc_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="slik_note" readonly="state != 'kyc'"/>
                            </group>
                        </page>
                        <page string="Survei" name="survey" invisible="state in ('baru', 'kyc')">
                            <group>
                                <group>
                                    <field name="survey_method" readonly="state != 'survei'"/>
                                    <field name="survey_date" readonly="state != 'survei'"
                                           invisible="survey_method == 'dilewati'"/>
                                    <field name="survey_user_id" readonly="state != 'survei'"
                                           invisible="survey_method == 'dilewati'"/>
                                    <field name="survey_met" readonly="state != 'survei'"
                                           invisible="survey_method == 'dilewati'"/>
                                </group>
                                <group>
                                    <field name="survey_location_match" readonly="state != 'survei'"/>
                                    <field name="survey_storage" readonly="state != 'survei'"/>
                                    <field name="survey_result" readonly="state != 'survei'"/>
                                </group>
                            </group>
                            <group>
                                <field name="survey_note" readonly="state != 'survei'"
                                       placeholder="Kondisi rumah dan lingkungan, usaha/omzet, konfirmasi tetangga/RT. Bila dilewati: alasannya."/>
                            </group>
                            <div class="text-muted">Foto survei diunggah di tab Dokumen.</div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pengajuan_search" model="ir.ui.view">
        <field name="name">koperasi.murabahah.pengajuan.search</field>
        <field name="model">koperasi.murabahah.pengajuan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="applicant_name"/>
                <field name="product_desc"/>
                <filter string="Dalam Proses" name="in_progress" domain="[('state', 'in', ('baru', 'kyc', 'survei', 'analisis'))]"/>
                <filter string="Pengajuan Saya" name="mine" domain="[('user_id', '=', uid)]"/>
                <filter string="Dari Website" name="website" domain="[('channel', '=', 'website')]"/>
                <separator/>
                <filter string="Ditolak/Batal" name="closed" domain="[('state', 'in', ('ditolak', 'batal'))]"/>
                <group>
                    <filter string="Tahap" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Kategori" name="group_kategori" context="{'group_by': 'kategori_id'}"/>
                    <filter string="Petugas" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pengajuan" model="ir.actions.act_window">
        <field name="name">Pengajuan</field>
        <field name="res_model">koperasi.murabahah.pengajuan</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catat permohonan pembiayaan di sini</p>
            <p>Semua permohonan (WhatsApp, website, datang langsung) dicatat pada hari yang sama, lalu melewati
               pra-skrining, verifikasi KYC + dokumen, dan survei sebelum dibuat akad untuk dianalisis dan diputus.</p>
        </field>
    </record>

    <!-- Konfigurasi -->
    <record id="view_kategori_list" model="ir.ui.view">
        <field name="name">koperasi.pembiayaan.kategori.list</field>
        <field name="model">koperasi.pembiayaan.kategori</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="margin_pct"/>
                <field name="min_dp_pct"/>
                <field name="max_tenor"/>
                <field name="is_vehicle"/>
                <field name="note"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_kategori" model="ir.actions.act_window">
        <field name="name">Kategori Pembiayaan</field>
        <field name="res_model">koperasi.pembiayaan.kategori</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_dokumen_jenis_list" model="ir.ui.view">
        <field name="name">koperasi.dokumen.jenis.list</field>
        <field name="model">koperasi.dokumen.jenis</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="phase"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="required"/>
                <field name="original_check"/>
                <field name="spouse_only"/>
                <field name="guarantor_only"/>
                <field name="vehicle_only"/>
                <field name="kategori_ids" widget="many2many_tags"/>
                <field name="description" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dokumen_jenis_search" model="ir.ui.view">
        <field name="name">koperasi.dokumen.jenis.search</field>
        <field name="model">koperasi.dokumen.jenis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group>
                    <filter string="Tahap" name="group_phase" context="{'group_by': 'phase'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dokumen_jenis" model="ir.actions.act_window">
        <field name="name">Checklist Dokumen</field>
        <field name="res_model">koperasi.dokumen.jenis</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_phase': 1}</field>
    </record>
</odoo>
