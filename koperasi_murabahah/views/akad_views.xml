<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_akad_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.akad.form</field>
        <field name="model">koperasi.murabahah.akad</field>
        <field name="arch" type="xml">
            <form string="Akad Murabahah">
                <header>
                    <button name="action_approve" type="object" string="Setujui" class="btn-primary"
                            invisible="state != 'draft'" groups="koperasi_base.group_koperasi_pengurus"/>
                    <button name="action_compute_schedule" type="object" string="Hitung Jadwal"
                            invisible="state != 'draft'"/>
                    <button name="action_open_down_payment_wizard" type="object" string="Terima Uang Muka"
                            invisible="state not in ('disetujui', 'barang_dibeli') or down_payment_move_id or down_payment &lt;= 0"
                            groups="koperasi_base.group_koperasi_petugas"/>
                    <button name="action_open_purchase_wizard" type="object" string="Catat Pembelian Barang" class="btn-primary"
                            invisible="state != 'disetujui'" groups="koperasi_base.group_koperasi_petugas"/>
                    <button name="action_activate" type="object" string="Aktifkan Akad" class="btn-primary"
                            invisible="state != 'barang_dibeli'" groups="koperasi_base.group_koperasi_pengurus"
                            confirm="Akad akan diaktifkan dan jurnal akad diposting. Angka akad tidak bisa diubah lagi. Lanjutkan?"/>
                    <button name="action_open_payment_wizard" type="object" string="Terima Angsuran" class="btn-primary"
                            invisible="state != 'aktif'" groups="koperasi_base.group_koperasi_petugas"/>
                    <button name="action_open_payoff_wizard" type="object" string="Pelunasan Dipercepat"
                            invisible="state != 'aktif'" groups="koperasi_base.group_koperasi_pengurus"/>
                    <button name="action_open_reschedule_wizard" type="object" string="Penjadwalan Kembali"
                            invisible="state != 'aktif'" groups="koperasi_base.group_koperasi_pengurus"/>
                    <button name="action_reset_draft" type="object" string="Kembalikan ke Pengajuan"
                            invisible="state != 'disetujui' or purchase_move_id or down_payment_move_id"
                            groups="koperasi_base.group_koperasi_pengurus"/>
                    <button name="action_open_dp_refund_wizard" type="object" string="Kembalikan Uang Muka" class="btn-primary"
                            invisible="state != 'batal' or dp_refund_move_id or not down_payment_move_id"
                            groups="koperasi_base.group_koperasi_pengurus"/>
                    <button name="action_cancel" type="object" string="Batal"
                            invisible="state in ('lunas', 'batal')" groups="koperasi_base.group_koperasi_pengurus"
                            confirm="Batalkan akad ini?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,disetujui,barang_dibeli,aktif,lunas"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Pembayaran"/>
                        </button>
                        <button name="%(action_agunan)d" type="action" class="oe_stat_button" icon="fa-lock"
                                context="{'search_default_akad_id': id, 'default_akad_id': id, 'search_default_dipegang': 0}"
                                invisible="not agunan_count">
                            <field name="agunan_count" widget="statinfo" string="Agunan"/>
                        </button>
                        <button name="action_view_pengajuan" type="object" class="oe_stat_button" icon="fa-id-card-o"
                                invisible="not pengajuan_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pengajuan</span>
                                <span class="o_stat_value"><field name="pengajuan_id" readonly="1" options="{'no_open': True}"/></span>
                            </div>
                        </button>
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book"
                                groups="koperasi_base.group_koperasi_akuntan,koperasi_base.group_koperasi_pengurus">
                            <field name="move_count" widget="statinfo" string="Jurnal"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Lunas" bg_color="text-bg-success" invisible="state != 'lunas'"/>
                    <widget name="web_ribbon" title="Batal" bg_color="text-bg-danger" invisible="state != 'batal'"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not is_pengurus_financing or state != 'draft'">
                        Pembiayaan untuk <strong>pengurus</strong>: tidak boleh disetujui oleh yang bersangkutan, dan wajib diisi
                        Dasar Persetujuan (mis. keputusan rapat pengurus/pengawas).
                    </div>
                    <div class="alert alert-danger mb-2" role="alert" invisible="partner_risk_level != 'tinggi' or state != 'draft'">
                        Tingkat risiko KYC pemohon <strong>tinggi</strong>: persetujuan wajib disertai Dasar Persetujuan
                        (sebaiknya rapat 2 pengurus).
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not dsr_over_limit or state != 'draft'">
                        DSR <field name="dsr" readonly="1" class="oe_inline"/>% melebihi batas. Persetujuan wajib disertai Dasar Persetujuan.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Anggota &amp; Barang">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="member_no"/>
                            <field name="partner_status"/>
                            <field name="penjamin_id" readonly="state != 'draft'"
                                   invisible="partner_status == 'anggota' and not penjamin_id"/>
                            <field name="penjamin_relation" readonly="state != 'draft'" invisible="not penjamin_id"/>
                            <field name="is_pengurus_financing" invisible="not is_pengurus_financing"/>
                            <field name="product_desc" readonly="state not in ('draft', 'disetujui')"/>
                            <field name="product_id" readonly="state not in ('draft', 'disetujui')"/>
                            <field name="supplier_id" readonly="state not in ('draft', 'disetujui')"/>
                            <field name="is_migrated" invisible="not is_migrated"/>
                        </group>
                        <group string="Tanggal">
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_akad" readonly="state not in ('draft', 'disetujui', 'barang_dibeli')"/>
                            <field name="first_due_date" readonly="state != 'draft'"/>
                            <field name="date_done" invisible="not date_done"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Harga">
                            <field name="purchase_price" readonly="state != 'draft'"/>
                            <field name="direct_cost" readonly="state != 'draft'"/>
                            <field name="supplier_discount" readonly="state != 'draft'"/>
                            <field name="cost_price" readonly="state != 'draft' or purchase_price or direct_cost or supplier_discount"
                                   force_save="1"/>
                            <field name="down_payment" readonly="state != 'draft'"/>
                            <field name="margin_pct" readonly="state != 'draft'"/>
                            <field name="margin_amount" readonly="state != 'draft'"/>
                            <field name="sale_price"/>
                            <field name="financed_amount"/>
                            <field name="tenor" readonly="state != 'draft'"/>
                            <field name="installment_amount" readonly="state != 'draft'"/>
                        </group>
                        <group string="Saldo" invisible="state in ('draft', 'batal')">
                            <field name="amount_paid"/>
                            <field name="margin_recognized"/>
                            <field name="discount_amount" invisible="not discount_amount"/>
                            <field name="remaining_receivable"/>
                            <field name="remaining_principal"/>
                            <field name="remaining_margin"/>
                            <field name="arrears_amount" invisible="state != 'aktif'"/>
                            <field name="arrears_days" invisible="state != 'aktif'"/>
                            <field name="collectibility" invisible="state != 'aktif'"
                                   decoration-success="collectibility == 'lancar'"
                                   decoration-warning="collectibility in ('dpk', 'kurang_lancar')"
                                   decoration-danger="collectibility in ('diragukan', 'macet')" widget="badge"/>
                            <field name="next_due_date" invisible="state != 'aktif'"/>
                            <field name="reschedule_count" invisible="not reschedule_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Analisis &amp; Persetujuan" name="analysis">
                            <group>
                                <group string="Kemampuan Bayar">
                                    <field name="income_source" readonly="state != 'draft'"/>
                                    <field name="monthly_income" readonly="state != 'draft'"/>
                                    <field name="other_obligations" readonly="state != 'draft'"/>
                                    <field name="dependents" readonly="state != 'draft'"/>
                                    <field name="installment_amount" string="Angsuran Akad Ini" readonly="1"/>
                                    <field name="existing_installments"/>
                                    <field name="total_monthly_obligation"/>
                                    <field name="dsr" decoration-danger="dsr_over_limit"/>
                                    <field name="dsr_over_limit" invisible="1"/>
                                </group>
                                <group string="Tujuan &amp; Rekomendasi">
                                    <field name="financing_purpose" readonly="state != 'draft'"/>
                                    <field name="purpose_note" readonly="state != 'draft'"/>
                                    <field name="officer_recommendation" readonly="state != 'draft'" widget="radio"/>
                                    <field name="analyst_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="analysis_date" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <field name="analysis_note" readonly="state != 'draft'"
                                   placeholder="Karakter, kemampuan bayar, modal, agunan, kondisi (5C), hasil kunjungan, catatan lain..."/>
                            <group string="Persetujuan">
                                <group>
                                    <field name="approved_by_id" invisible="not approved_by_id"/>
                                    <field name="approval_date" invisible="not approval_date"/>
                                </group>
                                <group/>
                            </group>
                            <field name="approval_note" readonly="state != 'draft'"
                                   placeholder="Dasar persetujuan: wajib jika DSR melebihi batas, rekomendasi tidak layak, atau pembiayaan untuk pengurus"/>
                        </page>
                        <page string="Jadwal Angsuran" name="schedule">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="state == 'lunas'" decoration-danger="status == 'telat'"
                                      decoration-warning="state == 'sebagian'">
                                    <field name="sequence"/>
                                    <field name="date_due"/>
                                    <field name="amount_principal" sum="Total"/>
                                    <field name="amount_margin" sum="Total"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="paid_total" sum="Total"/>
                                    <field name="discount_margin" optional="hide" sum="Total"/>
                                    <field name="residual" sum="Total"/>
                                    <field name="date_paid" optional="show"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'lunas'" decoration-danger="status == 'telat'"
                                           decoration-warning="status == 'sebagian'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Barang &amp; Dokumen" name="documents">
                            <group>
                                <group string="Spesifikasi Barang">
                                    <field name="product_brand" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_model" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_color" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_serial" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_serial2" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_condition" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="product_spec" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="supplier_invoice_ref" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                </group>
                                <group string="Serah Terima">
                                    <field name="date_supplier_handover" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="date_member_handover" readonly="state == 'batal'"/>
                                    <field name="handover_place" readonly="state == 'batal'"/>
                                    <field name="akad_explained" readonly="state == 'batal'"/>
                                    <field name="akad_copy_given" readonly="state == 'batal'"/>
                                </group>
                            </group>
                            <group>
                                <group string="Wa'd &amp; Wakalah">
                                    <field name="purchase_method" widget="radio" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="wad_date" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="wakalah_date" invisible="purchase_method != 'wakalah'"
                                           required="purchase_method == 'wakalah' and state in ('disetujui', 'barang_dibeli')"
                                           readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="wakil_id" invisible="purchase_method != 'wakalah'"
                                           readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="wakalah_max_price" invisible="purchase_method != 'wakalah'"
                                           readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="wakalah_scope" invisible="purchase_method != 'wakalah'"
                                           readonly="state in ('aktif', 'lunas', 'batal')"/>
                                </group>
                                <group string="Uang Muka (Akad Batal)" invisible="state != 'batal' or not down_payment_move_id">
                                    <field name="dp_held"/>
                                    <field name="dp_refund_amount" invisible="not dp_refund_move_id"/>
                                    <field name="dp_real_cost" invisible="not dp_refund_move_id"/>
                                    <field name="dp_refund_move_id" invisible="not dp_refund_move_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Khiyar (Hak Tukar Barang Cacat)">
                                    <field name="khiyar_days" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                    <field name="khiyar_terms" readonly="state in ('aktif', 'lunas', 'batal')"/>
                                </group>
                                <group string="Sanksi Keterlambatan">
                                    <field name="tazir_terms" readonly="state in ('aktif', 'lunas', 'batal')"
                                           placeholder="Kosongkan jika akad tidak mengenakan denda ta'zir"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Data barang dan ketentuan akad terkunci setelah akad aktif. Cetak dokumen lewat menu
                                <strong>Cetak</strong>: Surat Janji Pembelian (Wa'd), Akad Wakalah, Akad Murabahah, Surat Pengakuan Utang, Berita Acara Serah Terima.
                            </p>
                        </page>
                        <page string="Pembayaran" name="payments" invisible="not payment_ids">
                            <field name="payment_ids" readonly="1">
                                <list decoration-muted="state == 'cancel'">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="payment_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_principal" sum="Total"/>
                                    <field name="amount_margin" sum="Total"/>
                                    <field name="amount_discount" optional="hide" sum="Total"/>
                                    <field name="amount_tazir" optional="show" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Jurnal &amp; Kontrol" name="accounting"
                              groups="koperasi_base.group_koperasi_akuntan,koperasi_base.group_koperasi_pengurus">
                            <group>
                                <group string="Jurnal">
                                    <field name="purchase_move_id"/>
                                    <field name="down_payment_move_id"/>
                                    <field name="akad_move_id"/>
                                    <field name="dp_refund_move_id" invisible="not dp_refund_move_id"/>
                                    <field name="opening_move_id" invisible="not opening_move_id"/>
                                </group>
                                <group string="Kontrol Buku Besar">
                                    <field name="ledger_receivable_balance"/>
                                    <field name="ledger_deferred_margin_balance"/>
                                    <field name="ledger_mismatch" invisible="not ledger_mismatch"
                                           decoration-danger="ledger_mismatch"/>
                                </group>
                            </group>
                        </page>
                        <page string="Agunan" name="agunan">
                            <group>
                                <group>
                                    <field name="agunan_value_held"/>
                                    <field name="agunan_coverage" invisible="state not in ('aktif',)"/>
                                </group>
                            </group>
                            <field name="agunan_ids" readonly="state in ('lunas', 'batal')"
                                   context="{'default_akad_id': id}">
                                <list decoration-warning="must_return" decoration-muted="state in ('dikembalikan', 'dieksekusi')">
                                    <field name="name"/>
                                    <field name="agunan_type"/>
                                    <field name="description"/>
                                    <field name="document_no"/>
                                    <field name="appraisal_value" sum="Total"/>
                                    <field name="storage_location"/>
                                    <field name="state" widget="badge"/>
                                    <field name="must_return" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Restrukturisasi" name="reschedules" invisible="not reschedule_ids">
                            <field name="reschedule_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="remaining_receivable"/>
                                    <field name="arrears_days"/>
                                    <field name="old_count"/>
                                    <field name="new_count"/>
                                    <field name="new_installment"/>
                                    <field name="first_due_date"/>
                                    <field name="last_due_date"/>
                                    <field name="user_id"/>
                                    <field name="reason"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan" name="notes">
                            <field name="note" placeholder="Catatan akad, mis. wakalah, jaminan, kesepakatan khusus..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_akad_list" model="ir.ui.view">
        <field name="name">koperasi.murabahah.akad.list</field>
        <field name="model">koperasi.murabahah.akad</field>
        <field name="arch" type="xml">
            <list string="Akad Murabahah" decoration-muted="state in ('lunas', 'batal')" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="member_no" optional="show"/>
                <field name="product_desc"/>
                <field name="date_akad"/>
                <field name="tenor" optional="show"/>
                <field name="financed_amount" sum="Total"/>
                <field name="installment_amount" optional="show"/>
                <field name="remaining_receivable" sum="Total"/>
                <field name="remaining_margin" sum="Total" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'aktif'" decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Laporan: daftar akad aktif + sisa piutang + kolektibilitas -->
    <record id="view_akad_list_active_report" model="ir.ui.view">
        <field name="name">koperasi.murabahah.akad.list.active</field>
        <field name="model">koperasi.murabahah.akad</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Akad Aktif" create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_status" optional="show"/>
                <field name="product_desc"/>
                <field name="date_akad"/>
                <field name="financed_amount" sum="Total"/>
                <field name="amount_paid" sum="Total" optional="show"/>
                <field name="remaining_principal" sum="Total"/>
                <field name="remaining_margin" sum="Total"/>
                <field name="remaining_receivable" sum="Total"/>
                <field name="arrears_amount"/>
                <field name="arrears_days"/>
                <field name="collectibility" widget="badge"
                       decoration-success="collectibility == 'lancar'"
                       decoration-warning="collectibility in ('dpk', 'kurang_lancar')"
                       decoration-danger="collectibility in ('diragukan', 'macet')"/>
                <field name="reschedule_count" optional="show" string="Restrukturisasi"/>
                <field name="ledger_mismatch" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_akad_search" model="ir.ui.view">
        <field name="name">koperasi.murabahah.akad.search</field>
        <field name="model">koperasi.murabahah.akad</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_desc"/>
                <filter string="Pengajuan" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Dalam Proses" name="in_progress" domain="[('state', 'in', ('disetujui', 'barang_dibeli'))]"/>
                <filter string="Aktif" name="aktif" domain="[('state', '=', 'aktif')]"/>
                <filter string="Lunas" name="lunas" domain="[('state', '=', 'lunas')]"/>
                <filter string="Batal" name="batal" domain="[('state', '=', 'batal')]"/>
                <separator/>
                <filter string="Menunggak" name="menunggak" domain="[('arrears_amount', '>', 0)]"/>
                <filter string="Akad Saldo Awal" name="migrated" domain="[('is_migrated', '=', True)]"/>
                <filter string="Direstrukturisasi" name="rescheduled" domain="[('reschedule_count', '>', 0)]"/>
                <filter string="Pembiayaan Pengurus" name="pengurus" domain="[('is_pengurus_financing', '=', True)]"/>
                <group>
                    <filter string="Anggota / Nasabah" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bulan Akad" name="group_date" context="{'group_by': 'date_akad:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_akad" model="ir.actions.act_window">
        <field name="name">Akad Murabahah</field>
        <field name="res_model">koperasi.murabahah.akad</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_akad_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat pengajuan pembiayaan murabahah</p>
            <p>Alur: Pengajuan → Disetujui → Barang Dibeli → Aktif → Lunas.</p>
        </field>
    </record>

    <record id="action_akad_active_report" model="ir.actions.act_window">
        <field name="name">Daftar Akad Aktif</field>
        <field name="res_model">koperasi.murabahah.akad</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_akad_list_active_report"/>
        <field name="domain">[('state', '=', 'aktif')]</field>
        <field name="search_view_id" ref="view_akad_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
