<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_angsuran_list" model="ir.ui.view">
        <field name="name">koperasi.murabahah.angsuran.list</field>
        <field name="model">koperasi.murabahah.angsuran</field>
        <field name="arch" type="xml">
            <list string="Jadwal Angsuran" create="false" edit="false" delete="false"
                  decoration-success="state == 'lunas'" decoration-danger="status == 'telat'">
                <field name="akad_id"/>
                <field name="partner_id"/>
                <field name="sequence"/>
                <field name="date_due"/>
                <field name="amount_principal" sum="Total" optional="show"/>
                <field name="amount_margin" sum="Total" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="paid_total" sum="Total"/>
                <field name="residual" sum="Total"/>
                <field name="days_late"/>
                <field name="state" column_invisible="1"/>
                <field name="status" widget="badge" decoration-success="status == 'lunas'"
                       decoration-danger="status == 'telat'" decoration-warning="status == 'sebagian'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_angsuran_search" model="ir.ui.view">
        <field name="name">koperasi.murabahah.angsuran.search</field>
        <field name="model">koperasi.murabahah.angsuran</field>
        <field name="arch" type="xml">
            <search>
                <field name="akad_id"/>
                <field name="partner_id"/>
                <filter string="Tunggakan" name="overdue"
                        domain="[('akad_state', '=', 'aktif'), ('state', '!=', 'lunas'), ('date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Jatuh Tempo 30 Hari" name="due_soon"
                        domain="[('akad_state', '=', 'aktif'), ('state', '!=', 'lunas'), ('date_due', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Belum Lunas" name="open" domain="[('state', '!=', 'lunas')]"/>
                <filter string="Lunas" name="paid" domain="[('state', '=', 'lunas')]"/>
                <separator/>
                <filter string="Jatuh Tempo" name="filter_date_due" date="date_due"/>
                <group>
                    <filter string="Anggota / Nasabah" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Akad" name="group_akad" context="{'group_by': 'akad_id'}"/>
                    <filter string="Bulan Jatuh Tempo" name="group_month" context="{'group_by': 'date_due:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_angsuran_overdue" model="ir.actions.act_window">
        <field name="name">Daftar Tunggakan</field>
        <field name="res_model">koperasi.murabahah.angsuran</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_angsuran_search"/>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tidak ada tunggakan</p>
        </field>
    </record>

    <record id="action_angsuran" model="ir.actions.act_window">
        <field name="name">Jadwal Angsuran</field>
        <field name="res_model">koperasi.murabahah.angsuran</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_angsuran_search"/>
        <field name="domain">[('akad_state', 'in', ('aktif', 'lunas'))]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
