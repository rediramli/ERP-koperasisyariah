<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dp_refund_wizard_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.dp.refund.wizard.form</field>
        <field name="model">koperasi.murabahah.dp.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Kembalikan Uang Muka">
                <p class="text-muted">
                    Akad batal: uang muka (hamish jiddiyyah) dikembalikan kepada anggota setelah dikurangi biaya riil yang sudah
                    dikeluarkan koperasi. Jika biaya riil lebih besar dari uang muka, kekurangannya ditagih terpisah.
                    Jurnal: Uang Muka Murabahah (D) / Kas (K) / Pendapatan Biaya Riil (K).
                </p>
                <group>
                    <group>
                        <field name="akad_id"/>
                        <field name="partner_id"/>
                        <field name="dp_held"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="real_cost"/>
                        <field name="real_cost_note" required="real_cost &gt; 0" invisible="not real_cost"/>
                        <field name="refund_amount"/>
                    </group>
                </group>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Kembalikan" class="btn-primary"
                            confirm="Jurnal pengembalian uang muka akan diposting. Lanjutkan?"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
