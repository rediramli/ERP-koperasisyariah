<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_down_payment_wizard_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.down.payment.wizard.form</field>
        <field name="model">koperasi.murabahah.down.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Terima Uang Muka">
                <p class="text-muted">Jurnal: Kas/Bank (D) / Uang Muka Murabahah (K). Saat akad aktif, uang muka diperhitungkan dengan piutang.</p>
                <group>
                    <field name="akad_id"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Terima" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
