<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_wizard_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.purchase.wizard.form</field>
        <field name="model">koperasi.murabahah.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Catat Pembelian Barang">
                <p class="text-muted">Barang harus sudah menjadi milik koperasi sebelum akad murabahah diaktifkan.
                    Jurnal: Persediaan Murabahah (D) / Kas atau Utang Usaha (K).</p>
                <group>
                    <field name="akad_id"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="mode" widget="radio"/>
                    <field name="journal_id" invisible="mode != 'kas'" required="mode == 'kas'"/>
                    <field name="supplier_id" required="mode == 'utang'"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Catat" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
