<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_wizard_form" model="ir.ui.view">
        <field name="name">koperasi.murabahah.payment.wizard.form</field>
        <field name="model">koperasi.murabahah.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Terima Angsuran">
                <group>
                    <group>
                        <field name="akad_id" options="{'no_create': True}"/>
                        <field name="partner_id"/>
                        <field name="remaining_receivable"/>
                        <field name="arrears_amount"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="amount"/>
                        <field name="akad_tazir_terms" invisible="1"/>
                        <field name="amount_tazir" invisible="not akad_tazir_terms"/>
                        <field name="tazir_confirmed" invisible="not amount_tazir"/>
                        <field name="memo"/>
                    </group>
                </group>
                <group string="Potongan Tagihan (Pengurus)" groups="koperasi_base.group_koperasi_pengurus">
                    <group>
                        <field name="discount_amount"/>
                        <field name="discount_type" invisible="not discount_amount" required="discount_amount &gt; 0"/>
                        <field name="discount_note" invisible="not discount_amount" required="discount_amount &gt; 0"/>
                    </group>
                    <div class="text-muted">
                        Penghargaan untuk anggota yang membayar tepat waktu, atau keringanan untuk anggota yang kemampuan
                        bayarnya menurun. Mengurangi margin angsuran yang dibayar. Jurnal: Kas (D) + Margin Ditangguhkan (D)
                        / Piutang Murabahah (K).
                    </div>
                </group>
                <group string="Alokasi (angsuran tertua lebih dulu)">
                    <field name="preview_installments"/>
                    <field name="preview_principal"/>
                    <field name="preview_margin"/>
                    <field name="preview_discount" invisible="not preview_discount"/>
                    <field name="preview_settled" invisible="not preview_discount"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not preview_error">
                    <field name="preview_error"/>
                </div>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Terima Angsuran" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
