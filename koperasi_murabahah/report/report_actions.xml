<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_kartu_angsuran" model="ir.actions.report">
        <field name="name">Kartu Angsuran</field>
        <field name="model">koperasi.murabahah.akad</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">koperasi_murabahah.report_kartu_angsuran</field>
        <field name="print_report_name">'Kartu Angsuran - %s - %s' % (object.name, object.partner_id.name)</field>
        <field name="binding_model_id" ref="model_koperasi_murabahah_akad"/>
        <field name="binding_type">report</field>
    </record>

